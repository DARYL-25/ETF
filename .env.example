# All optional for local development. With no values the app runs on an embedded
# Postgres loaded from data/seed, and sign-in is switched off.

# Public ETF data (use a read-only role on the Supabase connection pooler)
DATABASE_URL=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site address used in sign-in email links, for example https://example.com
NEXT_PUBLIC_SITE_URL=


# AI assistant. Without a key, search still works from the database and no AI is used.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5

# Payments (Stripe). Leave empty to keep every feature free and payments off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Server only. Lets the Stripe webhook write the subscriptions table.
SUPABASE_SERVICE_ROLE_KEY=

# Data jobs only (GitHub Actions secrets, not the website): the database the daily job loads.
SYNC_DATABASE_URL=

# Who runs the service, shown on the legal notice. Until these are set the page says the details will follow.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_GOVERNING_LAW=

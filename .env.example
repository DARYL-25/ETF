# All optional for local development. With no values the app runs on an embedded
# Postgres loaded from data/seed, and sign-in is switched off.

# Public ETF data (use a read-only role on the Supabase connection pooler)
DATABASE_URL=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site address used in sign-in email links, for example https://example.com
NEXT_PUBLIC_SITE_URL=

# Price ingestion only (scripts/ingest-prices.ts). Never expose to the browser.
ALPHA_VANTAGE_API_KEY=
INGEST_DATABASE_URL=

# AI assistant. Without a key, search still works from the database and no AI is used.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
